# DB接続情報。ビルドのとき sqlx のマクロが読む (just sqlx-prepare・just db-migrate は読まない)。
# git worktree の中でもビルドするなら、絶対パス (sqlite:/path/to/data/dev-runtime/bp-carnet.db) にする。
# worktree からも親のフォルダのこの .env が読まれ、相対パスは worktree から見たパスになるため
DATABASE_URL=sqlite://data/dev-runtime/bp-carnet.db

# Google OAuth ログインのクライアントID/シークレット
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# LINE ログインのチャネルID/チャネルシークレット (LINE Developers の LINE ログインチャネル)
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=

# Sign in with Apple (Apple Developer の Certificates, Identifiers & Profiles)。
# チームID・キーID と、Sign in with Apple を有効にした鍵 (.p8) の中身。改行は \n と書いてもよい。
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# ウェブのサービス ID (config.toml の public_url も要る) と、アプリの Bundle ID。使う方だけでよい。
# APPLE_SERVICE_ID=
# APPLE_APP_BUNDLE_ID=

# アプリ内課金 (App Store Connect の「ユーザとアクセス」→「統合」→「アプリ内課金」の鍵)。
# Sign in with Apple の鍵とは別。APPLE_APP_BUNDLE_ID も要る。
# APP_STORE_ISSUER_ID=
# APP_STORE_KEY_ID=
# APP_STORE_PRIVATE_KEY=

# Gemini API のAPIキー
# GEMINI_API_KEY=
# 写真の読み取りの無料枠 (円)・買い足し1回の量 (円)・単価。config.toml の [ocr]・[ocr.pricing] より優先する
# (→ config.example.toml)。GEMINI_API_KEY があるなら無料枠と単価が、
# Stripe かアプリ内課金の鍵があるなら買い足しの量が要る (無いと起動しない)。
# OCR_FREE_BUDGET_YEN=
# OCR_TOPUP_GRANT_YEN=
# OCR_INPUT_USD_PER_MILLION_TOKENS=
# OCR_OUTPUT_USD_PER_MILLION_TOKENS=
# OCR_JPY_PER_USD=

# メール送信 (SMTP) のパスワード。接続先等は config.toml の [mail]
# SMTP_PASSWORD=

# Stripe (OCR 枠の買い足し)。config.toml の [payments.stripe] enabled=true と URL 設定も要る。
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_OCR_TOPUP_PRICE_ID=
# 手動の税率「消費税 10%・税込み」。有効になる条件ではないが、2026-12-01 からは無いと Checkout を作らない。
# STRIPE_TAX_RATE_ID=
